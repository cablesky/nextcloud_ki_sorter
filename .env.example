# KI-Anbieter Auswahl: gemini | ollama
AI_PROVIDER=gemini

# Google Gemini API Konfiguration
GEMINI_API_KEY=dein_google_gemini_api_key_hier
GEMINI_MODEL=gemini-2.5-flash

# Lokale KI (Ollama) Konfiguration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=optionaler_bearer_token

# Nextcloud WebDAV Zugangsdaten
NEXTCLOUD_URL=https://deine-nextcloud-domain.de
NEXTCLOUD_USER=hermes
NEXTCLOUD_PASSWORD=dein_nextcloud_app_passwort

# Ordner-Struktur Konfiguration
TARGET_ROOT_FOLDER=/Dokumente
INBOX_FOLDER=/Posteingang

# Telegram Benachrichtigungen (optional)
TELEGRAM_BOT_TOKEN=dein_telegram_bot_token_hier
TELEGRAM_CHAT_ID=deine_telegram_chat_id_hier
