# Google Gemini API Konfiguration
GEMINI_API_KEY=dein_google_gemini_api_key_hier
GEMINI_MODEL=gemini-2.5-flash

# Nextcloud WebDAV Zugangsdaten
NEXTCLOUD_URL=https://deine-nextcloud-domain.de
NEXTCLOUD_USER=hermes
NEXTCLOUD_PASSWORD=dein_nextcloud_app_passwort

# Ordner-Struktur Konfiguration
TARGET_ROOT_FOLDER=/Dokumente
INBOX_FOLDER=/Posteingang
